FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG NEXT_PUBLIC_HASURA_URL
ARG NEXT_PUBLIC_HASURA_WS
ARG NEXT_PUBLIC_HASURA_WS_IP
ARG NEXT_PUBLIC_HASURA_SECRET
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SITE_ID
ARG NEXT_PUBLIC_SITE_CODE
ARG NEXT_PUBLIC_SITE_NAME
ARG NEXT_PUBLIC_SITE_LOCATION
ARG NEXT_PUBLIC_SITE_REGION
ARG NEXT_PUBLIC_MINIO_URL
ARG NEXT_PUBLIC_DEVICE_CHECK_PROD_MODE
ARG NEXT_PUBLIC_DEVICE_CHECK_TIMEOUT_MS
ARG NEXT_PUBLIC_ANPR_IP
ARG NEXT_PUBLIC_AXLE_IP
ARG NEXT_PUBLIC_WIM_IP
ARG WIM_AGENT_STREAM_URL

ENV NEXT_PUBLIC_HASURA_URL=$NEXT_PUBLIC_HASURA_URL
ENV NEXT_PUBLIC_HASURA_WS=$NEXT_PUBLIC_HASURA_WS
ENV NEXT_PUBLIC_HASURA_WS_IP=$NEXT_PUBLIC_HASURA_WS_IP
ENV NEXT_PUBLIC_HASURA_SECRET=$NEXT_PUBLIC_HASURA_SECRET
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SITE_ID=$NEXT_PUBLIC_SITE_ID
ENV NEXT_PUBLIC_SITE_CODE=$NEXT_PUBLIC_SITE_CODE
ENV NEXT_PUBLIC_SITE_NAME=$NEXT_PUBLIC_SITE_NAME
ENV NEXT_PUBLIC_SITE_LOCATION=$NEXT_PUBLIC_SITE_LOCATION
ENV NEXT_PUBLIC_SITE_REGION=$NEXT_PUBLIC_SITE_REGION
ENV NEXT_PUBLIC_MINIO_URL=$NEXT_PUBLIC_MINIO_URL
ENV NEXT_PUBLIC_DEVICE_CHECK_PROD_MODE=$NEXT_PUBLIC_DEVICE_CHECK_PROD_MODE
ENV NEXT_PUBLIC_DEVICE_CHECK_TIMEOUT_MS=$NEXT_PUBLIC_DEVICE_CHECK_TIMEOUT_MS
ENV NEXT_PUBLIC_ANPR_IP=$NEXT_PUBLIC_ANPR_IP
ENV NEXT_PUBLIC_AXLE_IP=$NEXT_PUBLIC_AXLE_IP
ENV NEXT_PUBLIC_WIM_IP=$NEXT_PUBLIC_WIM_IP
ENV WIM_AGENT_STREAM_URL=$WIM_AGENT_STREAM_URL

RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3000
CMD ["node", "server.js"]
