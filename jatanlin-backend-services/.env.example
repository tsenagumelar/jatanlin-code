# ============================================
# SITE IDENTIFICATION (Multi-Site Support)
# ============================================
# PENTING: Setiap site/lokasi harus punya identifier unik!
# Site code harus match dengan code di master_site table
# UUID akan di-lookup otomatis dari database saat startup
# Gunakan code yang konsisten (bisa di-generate sendiri), bukan UUID random

SITE_CODE="SITE001"                    # Unique site code (must exist in master_site.code)
SITE_NAME="Default Site"               # Human-readable name (e.g., "Jakarta Toll Gate 1")
SITE_LOCATION="Central Office"         # Physical location (e.g., "Jakarta Outer Ring Road KM 12")
SITE_REGION="Default"                  # Region grouping (e.g., "Jakarta", "Surabaya", "Bandung")

# ============================================
# DATABASE CONFIGURATION
# ============================================

# Local Database (Required - untuk performa tinggi di site ini)
DATABASE_URL="postgres://username:password@localhost:5432/wim_db?sslmode=disable"

# Central HQ Database (Optional - untuk sinkronisasi data terpusat)
# Kosongkan jika tidak menggunakan sinkronisasi ke pusat
CENTRAL_DATABASE_URL="postgres://central_user:password@hq.example.com:5432/wim_central?sslmode=disable"
SYNC_ENABLED=false                     # Set true untuk enable sync ke central database

# ============================================
# API SERVER CONFIGURATION
# ============================================

API_PORT=4000
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"

# ============================================
# SERVICE SELECTION
# ============================================
# Uncomment salah satu sesuai service yang ingin dijalankan
# Pilihan: api | anpr-watcher | axle-watcher

# SERVICE=api
# SERVICE=anpr-watcher
# SERVICE=axle-watcher

# ============================================
# CCTV STREAMER CONFIGURATION
# ============================================
# mode: "rtsp" or "onvif"
CCTV_MODE="rtsp"

# Direct RTSP (used when CCTV_MODE=rtsp)
CCTV_RTSP_URL="rtsp://admin:P@ssw0rd@10.0.43.20:554/profile1"

# ONVIF (used when CCTV_MODE=onvif)
# Example endpoint: http://10.0.43.20/onvif/device_service
ONVIF_ENDPOINT="http://10.0.43.20/onvif/device_service"
ONVIF_USERNAME="admin"
ONVIF_PASSWORD="P@ssw0rd"
# Optional: specific profile token; empty = first profile
ONVIF_PROFILE_TOKEN=""
# Timeout in seconds for ONVIF calls
ONVIF_TIMEOUT_SECONDS=15

# ============================================
# RTSP STREAMING CONFIGURATION
# ============================================

RTSP_ENABLED=true
RTSP_URL="rtsp://admin:P@ssw0rd@10.0.43.20:554/live.sdp"

# ============================================
# CCTV RECORDING (FFMPEG REQUIRED)
# ============================================
# Rekam durasi singkat dari stream saat di-trigger
RECORD_SECONDS=20
# Folder output relatif ke lokasi menjalankan binary
RECORD_DIR="./recordings"
# Jika true, akan rekam otomatis saat start
RECORD_ON_START=false

# ============================================
# CCTV HTTP ENDPOINT
# ============================================
# Endpoint: POST http://localhost:8090/record?seconds=20
CCTV_HTTP_ENABLED=true
CCTV_HTTP_PORT=8090

# Prefix object name in attachment bucket for CCTV recordings
CCTV_UPLOAD_PREFIX="cctv"

# ============================================
# EXTERNAL CCTV TRIGGER (recording)
# ============================================

CCTV_TRIGGER_ENABLED=true
CCTV_TRIGGER_URL="http://localhost:8090/record"
CCTV_TRIGGER_SECONDS=20
CCTV_TRIGGER_DUMMY=false
CCTV_TRIGGER_FILENAME="e41ee755-20d4-4d51-885a-f3d4e8a6cf13-20260127_194341.mp4"
CCTV_TRIGGER_FILEPATH="attachment/e41ee755-20d4-4d51-885a-f3d4e8a6cf13-20260127_194341.mp4"

# ============================================
# ANPR FTP Configuration
# ============================================

ANPR_FTP_HOST="localhost:21"
ANPR_FTP_USER="anpr_user"
ANPR_FTP_PASS="anpr_password_123"
ANPR_FTP_DIR="/home/ftpuser/anpr"
ANPR_FTP_INTERVAL_SEC=5
ANPR_DUMMY_ENABLED=false

# ============================================
# ANPR MinIO Configuration
# ============================================

ANPR_MINIO_ENDPOINT="minio.example.com:9000"
ANPR_MINIO_ACCESS_KEY="anpr_minio_access_key"
ANPR_MINIO_SECRET_KEY="anpr_minio_secret_key_random_string_here"
ANPR_MINIO_BUCKET="anpr-images"
ANPR_MINIO_USE_SSL=true

# ============================================
# AXLE FTP Configuration
# ============================================

AXLE_FTP_HOST="localhost:21"
AXLE_FTP_USER="axle_user"
AXLE_FTP_PASS="axle_password_456"
AXLE_FTP_DIR="/home/ftpuser/axle"
AXLE_FTP_INTERVAL_SEC=5
AXLE_DUMMY_ENABLED=false

# ============================================
# AXLE MinIO Configuration
# ============================================

AXLE_MINIO_ENDPOINT="minio.example.com:9000"
AXLE_MINIO_ACCESS_KEY="axle_minio_access_key"
AXLE_MINIO_SECRET_KEY="axle_minio_secret_key_random_string_here"
AXLE_MINIO_BUCKET="axle-data"
AXLE_MINIO_USE_SSL=true

# ============================================
# ATTACHMENT MinIO Configuration
# ============================================

ATTACHMENT_MINIO_ENDPOINT="minio.example.com:9000"
ATTACHMENT_MINIO_ACCESS_KEY="attachment_minio_access_key"
ATTACHMENT_MINIO_SECRET_KEY="attachment_minio_secret_key_random_string_here"
ATTACHMENT_MINIO_BUCKET="attachment"
ATTACHMENT_MINIO_USE_SSL=true

# ===== Vehicle Dimension Detection Configuration =====

# Enable/disable vehicle dimension detection (true/false)
DIMENSION_ENABLED=true
DIMENSION_DUMMY_ENABLED=false

# Detection confidence threshold (0.0 - 1.0)
# Semakin tinggi, semakin strict filter detection
DIMENSION_THRESHOLD=0.5

# Path to ML model (optional - kosongkan untuk menggunakan mock detection)
DIMENSION_MODEL_PATH=

# ===== Camera Calibration Parameters =====
# Parameter ini SANGAT PENTING untuk akurasi perhitungan dimensi
# Harus dikalibrasi sesuai setup camera Anda

# Resolusi gambar dari camera ANPR Vidar
CAMERA_IMAGE_WIDTH=1920
CAMERA_IMAGE_HEIGHT=1080

# Focal length dalam pixel (biasanya 800-1500)
# Untuk estimasi: focal_length ≈ image_width (untuk FOV ~60°)
CAMERA_FOCAL_LENGTH=1000.0

# Tinggi camera dari permukaan jalan (dalam meter)
# Ukur dari lensa camera ke permukaan aspal
CAMERA_HEIGHT_METERS=6.0

# Sudut kemiringan camera (dalam derajat)
# 0° = horizontal (sejajar tanah)
# 45° = miring 45 derajat ke bawah
# 90° = tegak lurus ke bawah
CAMERA_TILT_ANGLE=30.0

# ===== Reference Object Calibration =====
# PENTING: Kalibrasi ini menentukan akurasi perhitungan!
# 
# Cara Kalibrasi:
# 1. Buka salah satu gambar ANPR di image editor (Photoshop, GIMP, Paint)
# 2. Cari objek yang ukurannya Anda tahu (contoh: mobil yang terlihat di gambar)
# 3. Jika ada mobil sedan (panjang ~4.5m), hitung berapa pixel panjangnya
# 4. Masukkan nilai tersebut di bawah

# Contoh Kalibrasi dengan Mobil Sedan:
# - Mobil sedan panjang sebenarnya: 4.5 meter
# - Dalam gambar terlihat panjang mobil: 300 pixel (ukur di image editor)
# - Jarak mobil dari camera: sekitar 15 meter (estimasi)
# 
# Maka:
# CAMERA_REF_PIXEL_LENGTH=300
# CAMERA_REF_REAL_LENGTH=4.5
# CAMERA_REF_DISTANCE=15.0

# Panjang objek referensi dalam PIXEL (ukur di gambar menggunakan image editor)
# NILAI SEMENTARA - HARUS DIUKUR DARI GAMBAR ASLI!
CAMERA_REF_PIXEL_LENGTH=1500

# Panjang SEBENARNYA objek referensi dalam METER
# NILAI SEMENTARA - SESUAIKAN dengan objek yang Anda ukur!
CAMERA_REF_REAL_LENGTH=5.0

# Jarak dari camera ke objek referensi (dalam meter)
# Estimasi jarak kendaraan/objek dari camera
CAMERA_REF_DISTANCE=15.0

# ============================================
# WIM SESSION & TRIGGERS
# ============================================

SESSION_WINDOW_SECONDS=60

# NATS (Queue)
NATS_URL="nats://51.79.173.213:4222"

# External Weighing Trigger
WEIGHING_TRIGGER_URL="http://localhost:5000/ws/wim/anpr-capture"
WEIGHING_TRIGGER_DIRECTION="RIGHT"
WEIGHING_TRIGGER_TIMEOUT_SECONDS=35
WEIGHING_TRIGGER_SAVE=true
WEIGHING_TRIGGER_DUMMY=false
