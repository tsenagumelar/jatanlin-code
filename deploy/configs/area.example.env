# Identity
AREA_CODE=mampang
SITE_CODE=MST-25-00001
SITE_NAME=Mampang
SITE_REGION=JABODETABEK
SITE_LOCATION="Jakarta Selatan"

# Images
WEB_IMAGE=taufansena/jtn-web:latest
GENERAL_API_IMAGE=taufansena/jtn-api-service:latest
ANPR_IMAGE=taufansena/jtn-anpr-service:latest
AXLE_IMAGE=taufansena/jtn-axle-service:latest
CCTV_IMAGE=taufansena/jtn-cctv-service:latest
WB_IMAGE=taufansena/jtn-wb-service:latest
SERVICE_PLATFORM=linux/arm64/v8

# Ports
WEB_PORT=13000
API_PORT=14000
WB_PORT=15000
HASURA_PORT=18080
NATS_PORT=14222
FTP_PORT=10021
POSTGRES_PORT=15432
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# Database
POSTGRES_DB=jatanlin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_IMAGE=postgres:15-alpine

# Hasura
HASURA_IMAGE=hasura/graphql-engine:v2.44.0
HASURA_GRAPHQL_ADMIN_SECRET=change-me-admin-secret
# Optional: default generated from JWT_SECRET if omitted
# HASURA_GRAPHQL_JWT_SECRET={"type":"HS256","key":"super-secret-jwt"}

# App security
JWT_SECRET=super-secret-jwt
AUTH_ENABLED=true

# MinIO
MINIO_IMAGE=minio/minio:latest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
ANPR_MINIO_BUCKET=anpr
AXLE_MINIO_BUCKET=axle
ATTACHMENT_MINIO_BUCKET=attachment

# NATS
NATS_IMAGE=nats:2.11-alpine
NATS_USER=nats
NATS_PASSWORD=natspass

# FTP
FTP_IMAGE=delfer/alpine-ftp-server:latest
ANPR_FTP_USER=ftpuser
ANPR_FTP_PASS=ftppass
AXLE_FTP_USER=ftpuser
AXLE_FTP_PASS=ftppass
ANPR_FTP_DIR=/anpr
AXLE_FTP_DIR=/axle
ANPR_DUMMY_ENABLED=true
AXLE_DUMMY_ENABLED=true

# Device integration
RTSP_URL=rtsp://admin:admin@192.168.1.18:554/live.sdp
CCTV_TRIGGER_DUMMY=true
WEIGHING_TRIGGER_DUMMY=true

# DB bootstrap
RUN_DB_MIGRATION_ON_INSTALL=true
RUN_MASTER_SEED_ON_INSTALL=true
DEFAULT_ADMIN_USERNAME=admin@mampang.local
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_FULL_NAME=Administrator Area
DEFAULT_ADMIN_EMAIL=admin@mampang.local
DEFAULT_ADMIN_BADGE_NO=ADM-MPG-001
DEFAULT_ADMIN_PHONE=
