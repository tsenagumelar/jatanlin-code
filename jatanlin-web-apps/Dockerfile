FROM node:23-alpine as builder

WORKDIR /jatanlin-web

COPY package.json package-lock.json ./

RUN npm install --legacy-peer-deps
RUN apk update && apk add --no-cache git tzdata

COPY . .

ARG NEXT_PUBLIC_HASURA_URL
ARG NEXT_PUBLIC_HASURA_WS
ARG NEXT_PUBLIC_HASURA_WS_IP
ARG NEXT_PUBLIC_HASURA_SECRET
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SITE_ID
ARG NEXT_PUBLIC_SITE_CODE
ARG NEXT_PUBLIC_SITE_NAME
ARG NEXT_PUBLIC_SITE_LOCATION
ARG NEXT_PUBLIC_SITE_REGION
ARG NEXT_PUBLIC_MINIO_URL

ENV NEXT_PUBLIC_HASURA_URL=$NEXT_PUBLIC_HASURA_URL \
  NEXT_PUBLIC_HASURA_WS=$NEXT_PUBLIC_HASURA_WS \
  NEXT_PUBLIC_HASURA_WS_IP=$NEXT_PUBLIC_HASURA_WS_IP \
  NEXT_PUBLIC_HASURA_SECRET=$NEXT_PUBLIC_HASURA_SECRET \
  NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
  NEXT_PUBLIC_SITE_ID=$NEXT_PUBLIC_SITE_ID \
  NEXT_PUBLIC_SITE_CODE=$NEXT_PUBLIC_SITE_CODE \
  NEXT_PUBLIC_SITE_NAME=$NEXT_PUBLIC_SITE_NAME \
  NEXT_PUBLIC_SITE_LOCATION=$NEXT_PUBLIC_SITE_LOCATION \
  NEXT_PUBLIC_SITE_REGION=$NEXT_PUBLIC_SITE_REGION \
  NEXT_PUBLIC_MINIO_URL=$NEXT_PUBLIC_MINIO_URL

RUN npm run build

FROM node:23-alpine as runner
WORKDIR /jatanlin-web

COPY --from=builder /jatanlin-web/package.json .
COPY --from=builder /jatanlin-web/package-lock.json .
COPY --from=builder /jatanlin-web/next.config.ts .
COPY --from=builder /jatanlin-web/public ./public
COPY --from=builder /jatanlin-web/.next/standalone ./
COPY --from=builder /jatanlin-web/.next/static ./.next/static

ARG NEXT_PUBLIC_HASURA_URL
ARG NEXT_PUBLIC_HASURA_WS
ARG NEXT_PUBLIC_HASURA_WS_IP
ARG NEXT_PUBLIC_HASURA_SECRET
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SITE_ID
ARG NEXT_PUBLIC_SITE_CODE
ARG NEXT_PUBLIC_SITE_NAME
ARG NEXT_PUBLIC_SITE_LOCATION
ARG NEXT_PUBLIC_SITE_REGION
ARG NEXT_PUBLIC_MINIO_URL

ENV NEXT_PUBLIC_HASURA_URL=$NEXT_PUBLIC_HASURA_URL \
  NEXT_PUBLIC_HASURA_WS=$NEXT_PUBLIC_HASURA_WS \
  NEXT_PUBLIC_HASURA_WS_IP=$NEXT_PUBLIC_HASURA_WS_IP \
  NEXT_PUBLIC_HASURA_SECRET=$NEXT_PUBLIC_HASURA_SECRET \
  NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
  NEXT_PUBLIC_SITE_ID=$NEXT_PUBLIC_SITE_ID \
  NEXT_PUBLIC_SITE_CODE=$NEXT_PUBLIC_SITE_CODE \
  NEXT_PUBLIC_SITE_NAME=$NEXT_PUBLIC_SITE_NAME \
  NEXT_PUBLIC_SITE_LOCATION=$NEXT_PUBLIC_SITE_LOCATION \
  NEXT_PUBLIC_SITE_REGION=$NEXT_PUBLIC_SITE_REGION \
  NEXT_PUBLIC_MINIO_URL=$NEXT_PUBLIC_MINIO_URL
RUN chown -R node:node /jatanlin-web
USER node

EXPOSE 3000
CMD ["node", "server.js"]
