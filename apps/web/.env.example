# ETLE integration - dipakai server-side oleh app/api/etle/send (jangan pakai prefix NEXT_PUBLIC_)
# Kredensial (usertoken/passtoken/client_secret) diberikan tim ETLE Korlantas.
ETLE_ENABLED=false
ETLE_BASE_URL=https://api-etle.polri.go.id
ETLE_CLIENT_ID=integrasi
ETLE_USER_TOKEN=
ETLE_PASS_TOKEN=
ETLE_CLIENT_SECRET=
ETLE_VIOLATION_CODE=TM
ETLE_VIOLATION_NAME="Melanggar Tata Cara Muatan"
# Base URL gambar publik. Kosong = pakai layout bucket MinIO Data Center di bawah.
ETLE_PUBLIC_IMAGE_BASE_URL=
# Master data kamera ETLE - dikelola dari site.json, jalankan `make site-apply` setelah diubah
ETLE_DEVICE_NAME=Jatanlin1
ETLE_CAMERA_TYPE="ANPR Camera"
ETLE_LOCATION_NAME="Central Office"
ETLE_LOCATION_DESCRIPTION="Jl. Mampang Prapatan Raya, Jakarta Selatan"
ETLE_LAT=
ETLE_LON=
ETLE_NRP=
ETLE_SATWIL=Korlantas
ETLE_PROVINCE="DKI Jakarta"
ETLE_COURT=
ETLE_PROSECUTOR=

# Dipakai untuk membangun URL gambar ETLE, mengikuti layout bucket yang ditulis
# sync-agent (background service, lihat services/backend/cmd/sync-agent)
DATA_CENTER_MINIO_ENDPOINT=minio.jatanlinkorlantas.id
DATA_CENTER_MINIO_BUCKET=jatanlin-data-center-attachments
DATA_CENTER_MINIO_USE_SSL=true
